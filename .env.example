# Storage backend: "local" or "minio"
ECOM_STORAGE_BACKEND=local

# Local backend paths (relative to repo root unless absolute)
ECOM_RAW_ROOT=data/raw
ECOM_PROCESSED_ROOT=data/processed

# Where the untouched Olist download lives (read-only source of truth)
ECOM_SOURCE_DIR=data

# MinIO backend (only read when ECOM_STORAGE_BACKEND=minio)
ECOM_MINIO_ENDPOINT=localhost:9000
ECOM_MINIO_ACCESS_KEY=minioadmin
ECOM_MINIO_SECRET_KEY=minioadmin
ECOM_MINIO_BUCKET=ecom-platform
ECOM_MINIO_SECURE=false

# Analysis window (see docs/CODING_STANDARDS.md "Analytical constants")
ECOM_WINDOW_START=2017-02-01
ECOM_WINDOW_END=2018-08-31

ECOM_LOG_LEVEL=INFO
